# Cabeceras para Cloudflare Pages.
# Las escenas son inmutables: se cachean un año para que la segunda visita
# no vuelva a descargar los 56 MB.
/assets/scenes/*
  Cache-Control: public, max-age=31536000, immutable

/assets/models/*
  Cache-Control: public, max-age=604800

# La configuración cambia con frecuencia: sin caché agresivo.
/config/*
  Cache-Control: public, max-age=60
